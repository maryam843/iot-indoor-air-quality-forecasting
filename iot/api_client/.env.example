# Copy to .env and fill in your own values. Never commit .env.
# Create an API key in Arduino Cloud (Account > API Keys).
ARDUINO_CLIENT_ID=
ARDUINO_CLIENT_SECRET=
# Optional: only needed if the Thing belongs to an organisation (e.g. a class space)
ARDUINO_ORG_ID=
ARDUINO_THING_ID=
RETENTION_DAYS=10
OUTPUT_CSV=dump1.csv
